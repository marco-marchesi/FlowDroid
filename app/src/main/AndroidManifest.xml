<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ PERMISSIONS ============ -->

    <!-- Foreground service (required from API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Special-use is required for our orchestrator service on API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- DataSync is the API 29-33 fallback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Post notifications (Android 13+ runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot completion / package replacement — required to re-arm services -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Allow user to whitelist us from battery optimisation -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wake locks: foreground service heartbeat occasionally needs short wakelocks. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Schedule exact alarms for time triggers. SCHEDULE_EXACT_ALARM requires the user to grant
         permission via Settings → Special app access → Alarms & reminders. USE_EXACT_ALARM is
         restricted to alarm-clock/calendar apps by Play policy, so we do NOT declare it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Internet for HTTP actions (Phase 1+) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vibration (used in Phase 1; declared early for self-test) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Phase 19: SendSms action. Dangerous permission — user must grant at runtime via system
         Settings → Apps → FlowDroid → Permissions → SMS. The action surfaces a clear error
         when the permission is missing rather than silently failing. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Phase 2: KillApp action uses ActivityManager.killBackgroundProcesses -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Phase 2: UI actions need to wake the device and dismiss keyguard to dispatch gestures. -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Query installed packages — required for the App Launch trigger (Phase 1+) -->
    <!-- Play Store may require justification; documented in §11 of PLAN.md. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".FlowDroidApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlowDroid"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <!-- ============ MAIN ACTIVITY ============ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FlowDroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent helper activity used by UI gesture actions to dismiss the keyguard.
             showWhenLocked + turnScreenOn so it appears above the lock screen.
             excludeFromRecents so it never shows up in the task switcher. -->
        <activity
            android:name=".service.UnlockHelperActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ============ FOREGROUND SERVICE ============
             The orchestrator. Keeps process warm, hosts heartbeat loop, owns service health state.
             Uses SPECIAL_USE on API 34+, DATA_SYNC on older. Declared via foregroundServiceType. -->
        <service
            android:name=".service.FlowDroidForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workflow automation requires a persistent process to receive notifications and run user-defined automations reliably." />
        </service>

        <!-- ============ ACCESSIBILITY SERVICE ============
             Phase 2+: dispatches synthetic gestures (tap/swipe/long-press) and reads the
             AccessibilityNodeInfo tree for BY_TEXT / BY_VIEW_ID resolution. User must enable
             in Settings → Accessibility → Installed services → FlowDroid. -->
        <service
            android:name=".service.FlowDroidAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_summary"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ============ NOTIFICATION LISTENER ============
             The single most reliability-critical component. Must be enabled in
             Settings → Notification access. The watchdog forces rebinds when killed. -->
        <service
            android:name=".service.FlowDroidNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing" />
        </service>

        <!-- ============ RECEIVERS ============ -->
        <!-- BOOT_COMPLETED / LOCKED_BOOT_COMPLETED / QUICKBOOT_POWERON are protected broadcasts:
             only the system can send them. So exported="false" is correct AND closes a small DoS
             surface (a misbehaving app cannot spam our bootstrap() via a forged BOOT_COMPLETED). -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Time triggers: AlarmManager wakes us via this receiver. Not exported — only our own
             PendingIntents target it, and only the OS can deliver Alarms back to us. -->
        <receiver
            android:name=".service.TimeTriggerReceiver"
            android:exported="false" />

        <!-- MY_PACKAGE_REPLACED is delivered to our own package only. exported="false" is correct. -->
        <receiver
            android:name=".service.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ============ WORKMANAGER ============
             We use the manual initialization pattern (via Configuration.Provider on
             the Application class) so Hilt can inject workers. Disable the default
             initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
