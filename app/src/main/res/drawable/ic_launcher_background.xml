<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. A vector (not a shape) so we can lay down a richer surface than a
  flat fill: a dark navy plate plus a soft elevated band behind the rail. Picks up the same
  bg / surface tokens used elsewhere in the app so the launcher icon feels like a window
  into the same product.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Base plate: deep navy from the theme tokens. -->
    <path
        android:fillColor="#11141A"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
    <!-- Subtle elevated band on top half — gives the icon a hint of depth at small sizes. -->
    <path
        android:fillColor="#1A1E26"
        android:pathData="M0,0 L108,0 L108,54 L0,54 Z" />
</vector>
